{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/main/**/*",
    "src/mcp/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "tests/**/*",
    "e2e/**/*",
    "*.mts",
    "playwright.config.ts"
  ]
}
